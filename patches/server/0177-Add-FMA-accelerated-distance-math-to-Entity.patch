From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BerryMC <BerryMC@users.noreply.github.com>
Date: Tue, 17 Nov 2026 02:35:01 +0800
Subject: [PATCH] Add FMA-accelerated distance math to Entity

Rewrite Entity#g(Entity)/d(double,double,double)/e(...)/h(Entity)
(distance/distanceToSqr family) to:
- compute in double precision and only cast once (the old code cast
  coordinates to float before multiplying, losing precision),
- use Math#sqrt directly instead of MathHelper.c/sqrt,
- optionally accelerate the squared-distance sum with Math#fma,
- be final so the JIT can inline them.

FMA is enabled via the JVM system property -DDionysus.enableFMA=true
(default off), following the LeafConstants approach of LeafMC - the
static final boolean lets the JIT constant-fold each branch.

Based on Leaf's 'Optimize Entity distanceToSqr' by HaHaWTH.

VarInt/varlong readers are untouched; wire format is unchanged.

diff --git a/src/main/java/dev/pomf/dionysus/util/DionysusConstants.java b/src/main/java/dev/pomf/dionysus/util/DionysusConstants.java
new file mode 100644
index 0000000000000000000000000000000000000000..4bacc16695b5be5bcf87cd98df4033287581a130
--- /dev/null
+++ b/src/main/java/dev/pomf/dionysus/util/DionysusConstants.java
@@ -0,0 +1,17 @@
+package dev.pomf.dionysus.util;
+
+// Dionysus start - JVM system properties, following the approach of Leaf's LeafConstants
+public final class DionysusConstants {
+
+    /**
+     * Enable Math#fma acceleration for hot math paths, e.g. Entity distance
+     * calculations. Enable with -DDionysus.enableFMA=true. Kept as a static final
+     * boolean (instead of a config value) so the JIT constant-folds every branch
+     * once the property is fixed at startup.
+     */
+    public static final boolean ENABLE_FMA = Boolean.getBoolean("Dionysus.enableFMA");
+
+    private DionysusConstants() {
+    }
+}
+// Dionysus end
diff --git a/src/main/java/net/minecraft/server/Entity.java b/src/main/java/net/minecraft/server/Entity.java
index fba64d34f0bc4cb7ffb55cd48fcf2f8a7f489877..b1b413888a6d274d4ddb6d1cfbc1877a6a81dd0d 100644
--- a/src/main/java/net/minecraft/server/Entity.java
+++ b/src/main/java/net/minecraft/server/Entity.java
@@ -1,5 +1,6 @@
 package net.minecraft.server;
 
+import dev.pomf.dionysus.util.DionysusConstants; // Dionysus
 import com.google.common.collect.Iterables;
 import com.google.common.collect.Lists;
 import com.google.common.collect.Sets;
@@ -1369,20 +1370,24 @@ public abstract class Entity implements ICommandListener, KeyedObject { // Paper
         this.setPosition(this.locX, this.locY, this.locZ);
     }
 
-    public float g(Entity entity) {
-        float f = (float) (this.locX - entity.locX);
-        float f1 = (float) (this.locY - entity.locY);
-        float f2 = (float) (this.locZ - entity.locZ);
+    // Dionysus start - optimize distance math: avoid float casts before multiplying, use
+    // Math#sqrt directly instead of MathHelper (only cast once) and optionally accelerate
+    // with Math#fma (enable with -DDionysus.enableFMA=true). Methods are final so the JIT
+    // can inline them. Based on Leaf's "Optimize Entity distanceToSqr" by HaHaWTH.
+    public final float g(Entity entity) {
+        final double d0 = this.locX - entity.locX;
+        final double d1 = this.locY - entity.locY;
+        final double d2 = this.locZ - entity.locZ;
 
-        return MathHelper.c(f * f + f1 * f1 + f2 * f2);
+        return (float) Math.sqrt(DionysusConstants.ENABLE_FMA ? Math.fma(d0, d0, Math.fma(d1, d1, d2 * d2)) : d0 * d0 + d1 * d1 + d2 * d2);
     }
 
-    public double d(double d0, double d1, double d2) {
-        double d3 = this.locX - d0;
-        double d4 = this.locY - d1;
-        double d5 = this.locZ - d2;
+    public final double d(double d0, double d1, double d2) {
+        final double d3 = this.locX - d0;
+        final double d4 = this.locY - d1;
+        final double d5 = this.locZ - d2;
 
-        return d3 * d3 + d4 * d4 + d5 * d5;
+        return DionysusConstants.ENABLE_FMA ? Math.fma(d3, d3, Math.fma(d4, d4, d5 * d5)) : d3 * d3 + d4 * d4 + d5 * d5;
     }
 
     public double c(BlockPosition blockposition) {
@@ -1393,21 +1398,18 @@ public abstract class Entity implements ICommandListener, KeyedObject { // Paper
         return blockposition.g(this.locX, this.locY, this.locZ);
     }
 
-    public double e(double d0, double d1, double d2) {
-        double d3 = this.locX - d0;
-        double d4 = this.locY - d1;
-        double d5 = this.locZ - d2;
+    public final double e(double d0, double d1, double d2) {
+        final double d3 = this.locX - d0;
+        final double d4 = this.locY - d1;
+        final double d5 = this.locZ - d2;
 
-        return (double) MathHelper.sqrt(d3 * d3 + d4 * d4 + d5 * d5);
+        return Math.sqrt(DionysusConstants.ENABLE_FMA ? Math.fma(d3, d3, Math.fma(d4, d4, d5 * d5)) : d3 * d3 + d4 * d4 + d5 * d5);
     }
 
-    public double h(Entity entity) {
-        double d0 = this.locX - entity.locX;
-        double d1 = this.locY - entity.locY;
-        double d2 = this.locZ - entity.locZ;
-
-        return d0 * d0 + d1 * d1 + d2 * d2;
+    public final double h(Entity entity) {
+        return this.d(entity.locX, entity.locY, entity.locZ); // Dionysus - reuse the FMA-capable distanceToSqr
     }
+    // Dionysus end
 
     public void d(EntityHuman entityhuman) {}
 
