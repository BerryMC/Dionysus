index 8e737718ee517d60b36ff0489d074c26c4ee67c4..49bf0e535909ba9d4103096e86ef3f9ab3da0ae4 100644
--- a/src/main/java/net/minecraft/server/BaseBlockPosition.java
+++ b/src/main/java/net/minecraft/server/BaseBlockPosition.java
@@ -42,10 +42,33 @@ public class BaseBlockPosition implements Comparable<BaseBlockPosition> {
         }
     }
 
-    public int hashCode() {
+    // Dionysus start - cache the hash code; BlockPosition instances are used as map keys all
+    // over NMS (Chunk.tileEntities is a HashMap<BlockPosition, TileEntity> and is looked up on
+    // every block update). NONE means "not computed yet" so a legitimate hash of 0 is fine.
+    // Subclasses whose coordinates can change must invalidate the cache.
+    private static final int NONE = Integer.MIN_VALUE;
+    private int hashCodeCache = NONE;
+
+    protected int computeHashCode() {
         return (this.getY() + this.getZ() * 31) * 31 + this.getX();
     }
 
+    public int hashCode() {
+        int hash = this.hashCodeCache;
+
+        if (hash == NONE) {
+            hash = this.computeHashCode();
+            this.hashCodeCache = hash;
+        }
+
+        return hash;
+    }
+
+    protected void invalidateHashCodeCache() {
+        this.hashCodeCache = NONE;
+    }
+    // Dionysus end
+
     public int l(BaseBlockPosition baseblockposition) {
         return this.getY() == baseblockposition.getY() ? (this.getZ() == baseblockposition.getZ() ? this.getX() - baseblockposition.getX() : this.getZ() - baseblockposition.getZ()) : this.getY() - baseblockposition.getY();
     }
