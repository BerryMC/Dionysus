@@ -743,18 +744,38 @@ public class WorldServer extends World implements IAsyncTaskHandler {
 
                 timings.scheduledBlocksCleanup.startTiming(); // Paper
                 NextTickListEntry nextticklistentry;
+                boolean optimizeScheduledTicks = DionysusConfig.optimizeScheduledTicks; // Dionysus
+                long now = this.worldData.getTime(); // Dionysus - hoist time lookup out of the loop
+
+                // Dionysus start - drain the set with a single pollFirst per entry instead of first() + remove()
+                if (optimizeScheduledTicks) {
+                    for (int j = 0; j < i; ++j) {
+                        nextticklistentry = (NextTickListEntry) this.nextTickList.pollFirst();
+                        if (nextticklistentry == null) {
+                            break;
+                        }
+
+                        if (!flag && nextticklistentry.b > now) {
+                            this.nextTickList.add(nextticklistentry); // put the not-yet-due entry back
+                            break;
+                        }
 
-                for (int j = 0; j < i; ++j) {
-                    nextticklistentry = (NextTickListEntry) this.nextTickList.first();
-                    if (!flag && nextticklistentry.b > this.worldData.getTime()) {
-                        break;
+                        this.W.add(nextticklistentry);
                     }
+                } else {
+                    for (int j = 0; j < i; ++j) {
+                        nextticklistentry = (NextTickListEntry) this.nextTickList.first();
+                        if (!flag && nextticklistentry.b > this.worldData.getTime()) {
+                            break;
+                        }
 
-                    // CraftBukkit - use nextTickList
-                    this.nextTickList.remove(nextticklistentry);
-                    // this.nextTickListHash.remove(nextticklistentry);
-                    this.W.add(nextticklistentry);
+                        // CraftBukkit - use nextTickList
+                        this.nextTickList.remove(nextticklistentry);
+                        // this.nextTickListHash.remove(nextticklistentry);
+                        this.W.add(nextticklistentry);
+                    }
                 }
+                // Dionysus end
                 timings.scheduledBlocksCleanup.stopTiming(); // Paper
 
                 this.methodProfiler.b();
@@ -767,7 +788,7 @@ public class WorldServer extends World implements IAsyncTaskHandler {
                     iterator.remove();
                     boolean flag1 = false;
 
-                    if (this.areChunksLoadedBetween(nextticklistentry.a.a(0, 0, 0), nextticklistentry.a.a(0, 0, 0))) {
+                    if (optimizeScheduledTicks ? this.areChunksLoadedBetween(nextticklistentry.a, nextticklistentry.a) : this.areChunksLoadedBetween(nextticklistentry.a.a(0, 0, 0), nextticklistentry.a.a(0, 0, 0))) { // Dionysus - pass the entry position directly, avoiding two BlockPosition allocations per entry
                         IBlockData iblockdata = this.getType(nextticklistentry.a);
                         co.aikar.timings.Timing timing = iblockdata.getBlock().getTiming(); // Paper
                         timing.startTiming(); // Paper
diff --git a/src/main/java/org/bukkit/craftbukkit/util/HashTreeSet.java b/src/main/java/org/bukkit/craftbukkit/util/HashTreeSet.java
index cd864c404747f8f77417e67ca319b3daa04bae59..39e89c9df35edeb76b8f7f6998aea60e64e88d31 100644
--- a/src/main/java/org/bukkit/craftbukkit/util/HashTreeSet.java
+++ b/src/main/java/org/bukkit/craftbukkit/util/HashTreeSet.java
@@ -114,4 +114,16 @@ public class HashTreeSet<V> implements Set<V> {
         return tree.first();
     }
 
+    // Dionysus start - add pollFirst to drain the set with a single tree operation
+    public V pollFirst() {
+        V v = tree.pollFirst();
+
+        if (v != null) {
+            hash.remove(v);
+        }
+
+        return v;
+    }
+    // Dionysus end
+
 }
