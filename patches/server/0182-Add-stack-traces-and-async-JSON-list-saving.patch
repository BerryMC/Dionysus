@@ -12,6 +12,7 @@ import com.google.gson.JsonObject;
 import com.google.gson.JsonParseException;
 import com.google.gson.JsonSerializationContext;
 import com.google.gson.JsonSerializer;
+import dev.pomf.dionysus.DionysusConfig; // Dionysus
 import java.io.BufferedReader;
 import java.io.BufferedWriter;
 import java.io.File;
@@ -164,11 +165,62 @@ public class JsonList<K, V extends JsonListEntry<K>> {
         return this.d;
     }
 
+    // Dionysus start - async JSON list saving; based on Akarin's "Save Json list
+    // asynchronously" as ported by Leaf. The JSON snapshot is still built on the calling
+    // thread so the backing map is never read concurrently; only the file write is
+    // offloaded. waitForPendingSaves() is called on server stop to flush pending writes.
+    private static final java.util.concurrent.ExecutorService dionysusSaveExecutor = java.util.concurrent.Executors.newSingleThreadExecutor((runnable) -> {
+        Thread thread = new Thread(runnable, "Dionysus-JsonList-Save");
+
+        thread.setDaemon(true);
+        return thread;
+    });
+    private static final java.util.concurrent.atomic.AtomicInteger dionysusPendingSaves = new java.util.concurrent.atomic.AtomicInteger();
+
+    public static void waitForPendingSaves() {
+        long deadline = System.currentTimeMillis() + 5000L;
+
+        while (dionysusPendingSaves.get() > 0 && System.currentTimeMillis() < deadline) {
+            try {
+                Thread.sleep(10L);
+            } catch (InterruptedException interruptedexception) {
+                Thread.currentThread().interrupt();
+                break;
+            }
+        }
+
+        if (dionysusPendingSaves.get() > 0) {
+            JsonList.a.warn("Timed out waiting for {} async JSON list save(s) to finish", (Object) dionysusPendingSaves.get());
+        }
+    }
+    // Dionysus end
+
     public void save() throws IOException {
         this.removeStaleEntries(); // Paper - remove expired values before saving
-        
+
         Collection collection = this.d.values();
-        String s = this.b.toJson(collection);
+        final String s = this.b.toJson(collection);
+
+        // Dionysus start - offload the file write
+        if (!DionysusConfig.asyncJsonListSave) {
+            this.dionysusWriteToFile(s);
+            return;
+        }
+
+        dionysusPendingSaves.incrementAndGet();
+        dionysusSaveExecutor.execute(() -> {
+            try {
+                this.dionysusWriteToFile(s);
+            } catch (IOException ioexception) {
+                JsonList.a.warn("Could not save the list asynchronously", ioexception);
+            } finally {
+                dionysusPendingSaves.decrementAndGet();
+            }
+        });
+        // Dionysus end
+    }
+
+    private void dionysusWriteToFile(String s) throws IOException { // Dionysus - extracted writer
         BufferedWriter bufferedwriter = null;
 
         try {
@@ -177,7 +229,6 @@ public class JsonList<K, V extends JsonListEntry<K>> {
         } finally {
             IOUtils.closeQuietly(bufferedwriter);
         }
-
     }
 
     public void load() throws FileNotFoundException {
