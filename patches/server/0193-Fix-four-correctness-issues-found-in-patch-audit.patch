+
+            return Date.from(zoneddatetime.toInstant());
+        } catch (DateTimeParseException datetimeparseexception) {
+            // Preserve the old SimpleDateFormat behavior for zone names like "UTC".
+            ZonedDateTime zoneddatetime = ZonedDateTime.parse(s, ExpirableListEntry.dionysusLooseFormatter);
 
-        return Date.from(zoneddatetime.toInstant());
