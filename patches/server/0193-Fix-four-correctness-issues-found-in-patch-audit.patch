@@ -738,12 +738,27 @@ public class TileEntityHopper extends TileEntityLootable implements IHopper, ITi
             // be found.
             boolean doEntitySearch = true;
             if (DionysusConfig.hopperOptimize) {
-                Chunk chunk = world.getChunkIfLoaded(i >> 4, k >> 4);
-                if (chunk == null || !chunk.hasHopperCandidateEntities(
-                        MathHelper.floor((d1 - 2.5D) / 16.0D),
-                        MathHelper.floor((d1 + 2.5D) / 16.0D))) {
-                    doEntitySearch = false;
+                // Dionysus start - conservative skip: only when the AABB (expanded by the
+                // same 2 blocks World#getEntities uses) stays inside ONE loaded chunk, so
+                // every slice the vanilla scan would touch is checked. At chunk borders we
+                // keep the scan, trading a little optimization for provable correctness.
+                int minChunkX = MathHelper.floor((d0 - 0.5D - 2.0D) / 16.0D);
+                int maxChunkX = MathHelper.floor((d0 + 0.5D + 2.0D) / 16.0D);
+                int minChunkZ = MathHelper.floor((d2 - 0.5D - 2.0D) / 16.0D);
+                int maxChunkZ = MathHelper.floor((d2 + 0.5D + 2.0D) / 16.0D);
+
+                if (minChunkX == maxChunkX && minChunkZ == maxChunkZ) {
+                    Chunk chunk = world.getChunkIfLoaded(minChunkX, minChunkZ);
+
+                    // Unloaded chunk => skip nothing (vanilla scan would find nothing there
+                    // anyway, but staying conservative keeps this trivially correct).
+                    if (chunk != null) {
+                        doEntitySearch = chunk.hasHopperCandidateEntities(
+                                MathHelper.floor((d1 - 0.5D - 2.0D) / 16.0D),
+                                MathHelper.floor((d1 + 0.5D + 2.0D) / 16.0D));
+                    }
                 }
+                // Dionysus end
             }
             if (doEntitySearch) {
