index 0000000000000000000000000000000000000000..009c8559995a2c76f972fef66ec28997ea5011b1
--- /dev/null
+++ b/src/main/java/dev/pomf/dionysus/command/RamBarCommand.java
@@ -0,0 +1,88 @@
+package dev.pomf.dionysus.command;
+
+import dev.pomf.dionysus.DionysusConfig;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import org.bukkit.ChatColor;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+
+/**
+ * /rambar [on|off|toggle] - toggles the heap-usage boss bar for the executing player.
+ * Ported from Purpur's /rambar (via Leaf); see RamBarTask for the rendering.
+ */
+public final class RamBarCommand extends Command {
+
+    private final RamBarTask task;
+
+    public RamBarCommand(RamBarTask task) {
+        super("rambar");
+
+        this.task = task;
+        this.description = "Toggles a boss bar showing server heap usage";
+        this.usageMessage = "/rambar [on|off|toggle]";
+        this.setPermission("dionysus.command.rambar");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String label, String[] args) {
+        if (!(sender instanceof Player)) {
+            sender.sendMessage("This command can only be used by a player.");
+            return true;
+        }
+
+        if (!DionysusConfig.ramBarEnabled) {
+            sender.sendMessage(ChatColor.RED + "The RAM bar is disabled on this server.");
+            return true;
+        }
+
+        Player player = (Player) sender;
+
+        if (!testPermission(sender)) {
+            return true;
+        }
+
+        boolean shown;
+
+        if (args.length == 0 || args[0].equalsIgnoreCase("toggle")) {
+            shown = this.task.togglePlayer(player);
+        } else if (args[0].equalsIgnoreCase("on")) {
+            if (this.task.hasPlayer(player)) {
+                shown = true;
+            } else {
+                shown = this.task.togglePlayer(player);
+            }
+        } else if (args[0].equalsIgnoreCase("off")) {
+            if (this.task.hasPlayer(player)) {
+                shown = !this.task.togglePlayer(player);
+            } else {
+                shown = false;
+            }
+        } else {
+            player.sendMessage(ChatColor.RED + "Usage: " + this.usageMessage);
+            return true;
+        }
+
+        player.sendMessage(ChatColor.GREEN + "RAM bar " + (shown ? "enabled" : "disabled") + ".");
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(CommandSender sender, String alias, String[] args) {
+        if (args.length == 1) {
+            List<String> options = new ArrayList<>();
+
+            for (String option : new String[] { "on", "off", "toggle" }) {
+                if (option.startsWith(args[0].toLowerCase(java.util.Locale.ROOT))) {
+                    options.add(option);
+                }
+            }
+
+            return options;
+        }
+
+        return Collections.emptyList();
+    }
+}
diff --git a/src/main/java/dev/pomf/dionysus/command/RamBarTask.java b/src/main/java/dev/pomf/dionysus/command/RamBarTask.java
new file mode 100644
index 0000000000000000000000000000000000000000..d97e589e36fe5be9048a495b92203760be0f90db
--- /dev/null
+++ b/src/main/java/dev/pomf/dionysus/command/RamBarTask.java
@@ -0,0 +1,161 @@
+package dev.pomf.dionysus.command;
+
+import dev.pomf.dionysus.DionysusConfig;
+import java.lang.management.ManagementFactory;
+import java.lang.management.MemoryUsage;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.UUID;
+import org.bukkit.Bukkit;
+import org.bukkit.boss.BarColor;
+import org.bukkit.boss.BarStyle;
+import org.bukkit.boss.BossBar;
+import org.bukkit.entity.Player;
+
+/**
+ * Per-player boss bar showing heap usage, ported from Purpur's /rambar (via Leaf).
+ * Driven from the server tick loop like {@link TPSBarTask}.
+ */
+public final class RamBarTask implements Runnable {
+
+    /** Dionysus - server-wide instance, driven from the tick loop. */
+    public static RamBarTask INSTANCE;
+
+    private final Map<UUID, BossBar> bossbars = new HashMap<>();
+    private long allocated;
+    private long used;
+    private long max;
+    private long init;
+    private float percent;
+    private int tick;
+
+    public boolean hasPlayer(Player player) {
+        return this.bossbars.containsKey(player.getUniqueId());
+    }
+
+    public boolean togglePlayer(Player player) {
+        if (removePlayer(player)) {
+            return false;
+        }
+
+        addPlayer(player);
+        return true;
+    }
+
+    public void addPlayer(Player player) {
+        removePlayer(player);
+
+        BossBar bossbar = Bukkit.createBossBar("", getBossBarColor(), BarStyle.SOLID);
+
+        this.bossbars.put(player.getUniqueId(), bossbar);
+        updateBossBar(bossbar);
+        bossbar.addPlayer(player);
+    }
+
+    public boolean removePlayer(Player player) {
+        BossBar bossbar = this.bossbars.remove(player.getUniqueId());
+
+        if (bossbar != null) {
+            bossbar.removePlayer(player);
+            return true;
+        }
+
+        return false;
+    }
+
+    public void removeAll() {
+        for (BossBar bossbar : new HashSet<>(this.bossbars.values())) {
+            bossbar.removeAll();
+        }
+
+        this.bossbars.clear();
+    }
+
+    @Override
+    public void run() {
+        if (++this.tick < Math.max(1, DionysusConfig.ramBarTickInterval)) {
+            return;
+        }
+
+        this.tick = 0;
+
+        MemoryUsage heap = ManagementFactory.getMemoryMXBean().getHeapMemoryUsage();
+
+        this.allocated = heap.getCommitted();
+        this.used = heap.getUsed();
+        this.max = heap.getMax();
+        this.init = heap.getInit();
+        this.percent = this.max <= 0L ? 0.0F : Math.max(Math.min((float) this.used / (float) this.max, 1.0F), 0.0F);
+
+        Iterator<Map.Entry<UUID, BossBar>> iterator = this.bossbars.entrySet().iterator();
+
+        while (iterator.hasNext()) {
+            Map.Entry<UUID, BossBar> entry = iterator.next();
+            Player player = Bukkit.getPlayer(entry.getKey());
+
+            if (player == null || !player.isOnline()) {
+                entry.getValue().removeAll();
+                iterator.remove();
+                continue;
+            }
+
+            updateBossBar(entry.getValue());
+        }
+    }
+
+    private void updateBossBar(BossBar bossbar) {
+        bossbar.setProgress(this.percent);
+        bossbar.setColor(getBossBarColor());
+
+        // 1.12.2 boss bar titles do not render legacy color codes: plain text only.
+        bossbar.setTitle(DionysusConfig.ramBarTitle
+                .replace("<allocated>", format(this.allocated))
+                .replace("<used>", format(this.used))
+                .replace("<xmx>", format(this.max))
+                .replace("<xms>", format(this.init))
+                .replace("<percent>", ((int) (this.percent * 100)) + "%"));
+    }
+
+    private BarColor getBossBarColor() {
+        if (this.percent < 0.5F) {
+            return toBarColor(DionysusConfig.ramBarColorGood);
+        } else if (this.percent < 0.75F) {
+            return toBarColor(DionysusConfig.ramBarColorMedium);
+        }
+
+        return toBarColor(DionysusConfig.ramBarColorLow);
+    }
+
+    private static BarColor toBarColor(DionysusConfig.TPSBarColor color) {
+        switch (color) {
+            case PINK:
+                return BarColor.PINK;
+            case BLUE:
+                return BarColor.BLUE;
+            case RED:
+                return BarColor.RED;
+            case GREEN:
+                return BarColor.GREEN;
+            case YELLOW:
+                return BarColor.YELLOW;
+            case PURPLE:
+                return BarColor.PURPLE;
+            case WHITE:
+            default:
+                return BarColor.WHITE;
+        }
+    }
+
+    /** Human-readable byte count, same BKMGTPE scheme Purpur uses. */
+    static String format(long v) {
+        if (v < 1024L) {
+            return v + "B";
+        }
+
+        int z = (63 - Long.numberOfLeadingZeros(v)) / 10;
+
+        return String.format("%.1f%s", (double) v / (double) (1L << (z * 10)), "BKMGTPE".charAt(z));
+    }
+}
