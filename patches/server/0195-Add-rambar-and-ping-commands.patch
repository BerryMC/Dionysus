@@ -0,0 +1,86 @@
+package dev.pomf.dionysus.command;
+
+import dev.pomf.dionysus.DionysusConfig;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import org.bukkit.Bukkit;
+import org.bukkit.ChatColor;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+
+/**
+ * /ping [player] - shows connection latency, ported from Purpur's /ping (via Leaf).
+ */
+public final class PingCommand extends Command {
+
+    public PingCommand() {
+        super("ping");
+
+        this.description = "Shows a player's connection latency";
+        this.usageMessage = "/ping [player]";
+        this.setPermission("dionysus.command.ping");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String label, String[] args) {
+        if (!DionysusConfig.pingCommandEnabled) {
+            sender.sendMessage(ChatColor.RED + "The ping command is disabled on this server.");
+            return true;
+        }
+
+        List<Player> targets = new ArrayList<>();
+
+        if (args.length == 0) {
+            if (!(sender instanceof Player)) {
+                sender.sendMessage("Usage: " + this.usageMessage);
+                return true;
+            }
+
+            targets.add((Player) sender);
+        } else {
+            if (!sender.hasPermission("dionysus.command.ping.other")) {
+                sender.sendMessage(ChatColor.RED + "You do not have permission to check other players.");
+                return true;
+            }
+
+            Player target = Bukkit.getPlayerExact(args[0]);
+
+            if (target == null) {
+                sender.sendMessage(ChatColor.RED + "Player '" + args[0] + "' is not online.");
+                return true;
+            }
+
+            targets.add(target);
+        }
+
+        if (!testPermission(sender)) {
+            return true;
+        }
+
+        for (Player target : targets) {
+            sender.sendMessage(ChatColor.GREEN + target.getName() + ": " + target.spigot().getPing() + "ms");
+        }
+
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(CommandSender sender, String alias, String[] args) {
+        if (args.length == 1 && sender.hasPermission("dionysus.command.ping.other")) {
+            List<String> names = new ArrayList<>();
+
+            for (Player player : Bukkit.getOnlinePlayers()) {
+                if (player.getName().toLowerCase(java.util.Locale.ROOT)
+                        .startsWith(args[0].toLowerCase(java.util.Locale.ROOT))) {
+                    names.add(player.getName());
+                }
+            }
+
+            return names;
+        }
+
+        return Collections.emptyList();
+    }
+}
diff --git a/src/main/java/dev/pomf/dionysus/command/RamBarCommand.java b/src/main/java/dev/pomf/dionysus/command/RamBarCommand.java
