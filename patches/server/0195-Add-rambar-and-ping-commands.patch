diff --git a/src/main/java/dev/pomf/dionysus/command/PingCommand.java b/src/main/java/dev/pomf/dionysus/command/PingCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..387c0dbdb0ced20f9855272695407e3576ba1b1d
