     }
 
     public final int getLight(BlockPosition blockposition, boolean checkNeighbors) { return this.c(blockposition, checkNeighbors); } // Paper - OBFHELPER
+    // Dionysus start - light level tail shared by the neighbor probes below. The chunk is
+    // resolved once by the caller instead of re-looked-up per neighbor.
+    private int a(BlockPosition blockposition, Chunk chunk) {
+        if (blockposition.getX() < -30000000 || blockposition.getZ() < -30000000 || blockposition.getX() >= 30000000 || blockposition.getZ() >= 30000000) {
+            return 15; // vanilla returns full light for out-of-bounds positions
+        }
+
+        if (blockposition.getY() < 0) {
+            return 0;
+        }
+
+        if (blockposition.getY() >= 256) {
+            blockposition = new BlockPosition(blockposition.getX(), 255, blockposition.getZ());
+        }
+
+        if (chunk == null) {
+            return 0;
+        }
+
+        return chunk.a(blockposition, this.L);
+    }
+
+    /** Dionysus - light level of a neighbor position, reusing the center's chunk when possible. */
+    private int a(BlockPosition blockposition, Chunk center, int centerChunkX, int centerChunkZ) {
+        Chunk chunk = (center != null && blockposition.getX() >> 4 == centerChunkX && blockposition.getZ() >> 4 == centerChunkZ)
+                ? center
+                : this.getChunkIfLoaded(blockposition);
+
+        return this.a(blockposition, chunk);
+    }
+
